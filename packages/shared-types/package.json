{
  "name": "@chat/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain types and entities for Chat",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./test-utils/domain-values": {
      "types": "./src/test-utils/domain-values.ts",
      "import": "./src/test-utils/domain-values.ts",
      "require": "./src/test-utils/domain-values.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
