@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
' 样式内联自 style.puml（勿改为 !include）
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("node", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Level 1] ExploreChat - 系统上下文

Person(user_web, "Web 用户", "浏览器：信息流、聊天、通话、探索")
Person(user_mobile, "移动端用户", "Expo 应用：信息流、Reels、聊天、通话")
Person(admin_user, "管理员", "运营后台：用户、内容与配置")

System(explorechat, "ExploreChat", "社交 + 即时通讯：Feed、帖子、评论、关注、聊天、音视频、搜索、通知；Nest API 边界")

System_Ext(email, "邮件服务", "事务邮件（SMTP / SES）")
System_Ext(push, "推送服务", "FCM / APNs")
System_Ext(storage, "文件存储", "本地盘或对象存储媒体")
System_Ext(webrtc, "STUN / TURN", "WebRTC NAT 穿透")
System_Ext(explore_ai, "Explore AI", "可选：经 Nest BFF 代理")

Rel(user_web, explorechat, "使用", "HTTPS / WebSocket / WebRTC")
Rel(user_mobile, explorechat, "使用", "HTTPS / WebSocket / WebRTC")
Rel(admin_user, explorechat, "管理", "HTTPS")
Rel(explorechat, email, "发送邮件", "SMTP")
Rel(explorechat, push, "发送推送", "HTTPS")
Rel(explorechat, storage, "存取媒体", "HTTPS / 本地 FS")
Rel(explorechat, webrtc, "媒体中继", "UDP / TCP")
Rel(explorechat, explore_ai, "服务间调用", "HTTPS + X-Service-Key")

SHOW_LEGEND()
@enduml
