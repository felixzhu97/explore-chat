@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
' 样式内联自 style.puml（勿改为 !include）
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("node", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Level 3] Chat - 组件图（Web / iOS / Spring）

Person(user_web, "Web 用户", "浏览器")
Person(user_ios, "iOS 用户", "SwiftUI 客户端")

System_Boundary(chat, "Chat") {

  Container_Boundary(web_app, "Web 应用 (src/main/web)") {
    Component(pages, "App Router 页面", "Next.js", "登录、主站、设置")
    Component(feed_ui, "Feed / Reels / Explore", "React", "帖子、互动、评论")
    Component(chat_ui, "聊天与通话", "React + @chat/im", "私信、WebRTC UI")
    Component(state, "状态层", "Redux Toolkit", "auth-session、消息、通知")
    Component(api_client, "API 客户端", "Fetch", "REST /api/v1")
    Component(ws_client, "WebSocket 客户端", "Socket.IO", "实时消息与通知")
  }

  Container_Boundary(ios_app, "iOS 应用 (src/main/ios)") {
    Component(ios_root, "App / RootView / Tabs", "SwiftUI", "鉴权门禁、主 Tab、Call 覆盖层")
    Component(ios_features, "Features", "SwiftUI", "Auth Feed Reels Explore Chat Profile Calls")
    Component(ios_api, "APIClient", "URLSession", "REST /api/v1 + RpcStatus")
    Component(ios_socket, "ChatSocketClient", "Socket.IO", "消息与通话信令")
    Component(ios_rtc, "WebRTCSession", "AVFoundation", "offer / answer / ICE")
    Component(ios_session, "SessionStore", "Keychain", "JWT 与当前用户")
  }

  Container_Boundary(api_server, "API 服务 (com.chat)") {
    Component(controllers, "REST 控制器", "Spring MVC", "auth users chats messages posts comments media search calls ai")
    Component(websocket, "Socket.IO", "netty-socketio", "chat / message 事件；:9002")
    Component(app_services, "应用服务", "@Service", "按 feature 编排；无业务规则外泄")
    Component(domain_model, "领域模型", "JPA entities / VOs", "User Chat Message Post Comment Follow")
    Component(domain_repos, "仓储接口", "domain.repository", "UserRepository ChatRepository …")
    Component(infra_adapters, "基础设施", "infra/", "JPA Jwt SocketIoConfig Upstream WebClient")
    ComponentDb(jpa_store, "持久化", "H2 / Postgres", "Liquibase；ddl-auto validate")
  }
}

Container_Ext(admin_app, "管理端", "Next.js", ":4001")
Container_Ext(media_gen, "Media Gen", "explore-ml", ":3456 可选")
Container_Ext(vision, "Vision", "explore-ml", ":8001 可选")
Container_Ext(recommendation, "Recommendation", "explore-ml", ":8000 可选")
Container_Ext(ollama, "Ollama", "LLM", ":11434 可选")

Rel(user_web, pages, "使用", "HTTPS")
Rel(user_ios, ios_root, "使用")
Rel(pages, feed_ui, "渲染")
Rel(pages, chat_ui, "渲染")
Rel(feed_ui, state, "读写")
Rel(chat_ui, ws_client, "实时")
Rel(state, api_client, "副作用")
Rel(api_client, controllers, "REST :9001")
Rel(ws_client, websocket, "Socket.IO :9002")

Rel(ios_root, ios_features, "导航")
Rel(ios_features, ios_api, "HTTP")
Rel(ios_features, ios_socket, "实时")
Rel(ios_features, ios_session, "读写会话")
Rel(ios_rtc, ios_socket, "信令")
Rel(ios_api, controllers, "REST :9001")
Rel(ios_socket, websocket, "Socket.IO :9002")

Rel(admin_app, controllers, "REST")
Rel(controllers, app_services, "调用")
Rel(websocket, app_services, "消息写路径")
Rel(app_services, domain_repos, "依赖")
Rel(app_services, domain_model, "编排")
Rel(infra_adapters, domain_repos, "实现")
Rel(infra_adapters, jpa_store, "JPA")
Rel(app_services, media_gen, "HTTP", "可选")
Rel(app_services, vision, "HTTP", "可选")
Rel(app_services, recommendation, "HTTP", "可选")
Rel(app_services, ollama, "HTTP", "可选")

note right of api_server
  分层：controller → service → domain ← infra (+ mapper)。
  限界上下文见 Glossary Preferred Terms。
end note

note right of ios_app
  契约见 src/main/ios/docs/API-Contract.md。
end note

SHOW_LEGEND()
@enduml
