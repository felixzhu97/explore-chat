@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
' 样式内联自 style.puml（勿改为 !include）
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("node", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Level 3] ExploreChat - 组件图（Web + Nest）

Person(user, "Web 用户", "浏览器客户端")

System_Boundary(explorechat, "ExploreChat") {
  Container_Boundary(web_app, "Web 应用") {
    Component(pages, "App Router 页面", "Next.js", "登录、主站、设置")
    Component(feed_ui, "Feed / Reels / Explore", "React", "帖子、互动、评论")
    Component(chat_ui, "聊天与通话", "React + im", "私信、WebRTC UI")
    Component(state, "状态层", "Redux Toolkit", "auth-session、消息、通知")
    Component(api_client, "API 客户端", "Fetch", "REST /api/v1")
    Component(ws_client, "WebSocket 客户端", "Socket.IO", "实时消息与通知")
  }

  Container_Boundary(auth_bc, "auth") {
    Component(auth_ctrl, "AuthController", "REST", "/api/v1/auth")
    Component(auth_svc, "AuthService", "Service", "注册 / 登录 / refresh JWT")
  }

  Container_Boundary(users_bc, "users") {
    Component(users_ctrl, "UsersController", "REST", "资料与查询")
    Component(users_svc, "UsersService", "Service", "用户用例")
  }

  Container_Boundary(post_bc, "post") {
    Component(post_ctrl, "PostController", "REST", "发帖 / Feed / explore")
    Component(post_svc, "PostService", "Service", "发帖、读帖、审核钩子")
    Component(fanout_svc, "FeedFanoutService", "Service", "进程内写 feed_entries")
    Component(post_repo, "Post / Feed / Engagement repos", "Prisma", "social_posts、feed_entries、likes")
  }

  Container_Boundary(comments_bc, "comments") {
    Component(comment_ctrl, "CommentController", "REST", "帖子评论")
    Component(comment_svc, "CommentService", "Service", "评论用例")
    Component(comment_repo, "CommentRepository", "Prisma", "post_comments")
  }

  Container_Boundary(search_bc, "search") {
    Component(search_ctrl, "SearchController", "REST", "/api/v1/search")
    Component(search_svc, "SearchService", "Service", "FTS5 + LIKE")
  }

  Container_Boundary(realtime_bc, "chats / websocket") {
    Component(graphql_api, "GraphQL", "Apollo", "feed / reels")
    Component(websocket, "ChatGateway", "Socket.IO", "消息与通话信令")
    Component(chat_svc, "Chats / Messages services", "Service", "会话与消息")
  }

  Container_Boundary(shared_infra, "core") {
    Component(prisma, "PrismaService", "SQLite", "统一持久化")
    Component(mem_cache, "RedisService (memory)", "In-process", "缓存 / seen / offline buffer")
  }
}

Container_Ext(media_gen, "Media Gen", "Python", ":3456 可选")
Container_Ext(vision, "Vision", "Python", ":8001 可选")
Container_Ext(explore_ai, "Explore AI", "外部", "BFF 可选")

Rel(user, pages, "使用", "HTTPS")
Rel(pages, feed_ui, "渲染")
Rel(pages, chat_ui, "渲染")
Rel(feed_ui, state, "读写")
Rel(chat_ui, ws_client, "实时")
Rel(state, api_client, "副作用")
Rel(api_client, auth_ctrl, "REST")
Rel(api_client, post_ctrl, "REST")
Rel(api_client, comment_ctrl, "REST")
Rel(api_client, search_ctrl, "REST")
Rel(api_client, graphql_api, "GraphQL")
Rel(ws_client, websocket, "WebSocket")

Rel(auth_ctrl, auth_svc, "调用")
Rel(auth_svc, users_svc, "用户")
Rel(users_svc, prisma, "Prisma")
Rel(post_ctrl, post_svc, "调用")
Rel(post_svc, post_repo, "持久化")
Rel(post_svc, fanout_svc, "fan-out")
Rel(post_svc, search_svc, "indexPost")
Rel(fanout_svc, post_repo, "写 Feed")
Rel(fanout_svc, mem_cache, "清 Feed 缓存")
Rel(comment_ctrl, comment_svc, "调用")
Rel(comment_svc, comment_repo, "Prisma")
Rel(search_ctrl, search_svc, "调用")
Rel(search_svc, prisma, "FTS / LIKE")
Rel(post_repo, prisma, "委托")
Rel(comment_repo, prisma, "委托")
Rel(websocket, chat_svc, "调用")
Rel(chat_svc, prisma, "Prisma")
Rel(post_svc, vision, "审核", "可选")
Rel(post_svc, media_gen, "生成", "可选")
Rel(auth_svc, explore_ai, "BFF", "可选")

note right of web_app
  Mobile / Admin 与 Web 同调 Nest；
  业务域目录见 Glossary。
end note

SHOW_LEGEND()
@enduml
