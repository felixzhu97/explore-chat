@startuml
!ROUNDED_STYLE=1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml
' 样式内联自 style.puml（勿改为 !include）
UpdateElementStyle("person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_person", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_system", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_container", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("external_component", "#FFFFFF", "#000000", "#000000")
UpdateElementStyle("node", "#FFFFFF", "#000000", "#000000")
UpdateBoundaryStyle("", $bgColor="#FFFFFF", $fontColor="#000000", $borderColor="#000000")
UpdateRelStyle("#000000", "#000000")
skinparam backgroundColor #FFFFFF
skinparam shadowing false

LAYOUT_WITH_LEGEND()
title [C4 Deployment] ExploreChat - 本地开发（+ 生产简述）

Deployment_Node(dev_machine, "开发机", "macOS / Linux") {
  Deployment_Node(browser, "浏览器", "") {
    Container(web, "Web / Admin", "Next.js", "http://localhost:4000（Admin :4001）")
  }

  Deployment_Node(node_procs, "Node 进程", "pnpm / turbo") {
    Container(api, "API 服务", "NestJS", "HOST=0.0.0.0 PORT=3001")
    Container(metro, "Expo Metro（可选）", "Expo Go", ":8081")
  }

  Deployment_Node(data, "数据", "文件") {
    ContainerDb(sqlite, "SQLite", "Prisma", "services/server/prisma/dev.db")
    Container(uploads, "uploads/", "本地目录", "媒体文件")
    Container(qdrant_dir, "Qdrant path（可选）", "本地目录", "RAG services/rag/data/qdrant")
  }

  Deployment_Node(py_svcs, "Python 旁路（可选）", "venv") {
    Container(rec, "Recommendation", "FastAPI", ":8000")
    Container(vision, "Vision", "FastAPI", ":8001")
    Container(rag, "RAG", "FastAPI", ":8002")
    Container(media, "Media Gen", "FastAPI", ":3456")
  }
}

Rel(web, api, "REST / GraphQL / WS", "localhost:3001")
Rel(metro, api, "REST / WS", "localhost:3001")
Rel(api, sqlite, "DATABASE_URL", "file:./dev.db")
Rel(api, uploads, "UPLOAD_DIR")
Rel(api, rec, "HTTP", "可选")
Rel(api, vision, "HTTP", "可选")
Rel(api, rag, "HTTP", "可选")
Rel(api, media, "HTTP", "可选")
Rel(rag, qdrant_dir, "path=", "本地")

note as N_PROD
  **生产（目标简述，非已上线证明）**：
  Web/Admin 可静态托管；API 容器绑定 $PORT；
  DATABASE_URL 可切换 Postgres；缓存可再接 Redis。
  本地 **不** 默认 docker compose。
end note

SHOW_LEGEND()
@enduml
