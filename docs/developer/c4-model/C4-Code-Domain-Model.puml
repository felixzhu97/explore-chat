ActivityNotification --> SocialPost

interface AuthService <<DomainService>> {
  register(data)
  login(data)
  refresh(token)
}
class AuthTokens <<ValueObject>> {
  String accessToken
  String refreshToken
}

AuthService ..> ChatUser
AuthService ..> AuthTokens

N_LAYERS .. ChatUser
N_LAYERS .. Chat
N_LAYERS .. SocialPost

' --- Client Local Chat Projection (TS web/mobile) ---
' Display name Message; alias ClientMessage avoids clash with Java Message.
class ChatId <<ValueObject>> {
  + value: String
}
class MessageId <<ValueObject>> {
  + value: String
}
class ClientMsgId <<ValueObject>> {
  + value: String
}
class SenderId <<ValueObject>> {
  + value: String
}
class MessageBody <<ValueObject>> {
  + text: String
}
class ChatTitle <<ValueObject>> {
  + value: String
}
class AvatarURL <<ValueObject>> {
  + value: String
}
class MessageDeliveryStatus <<ValueObject>> {
  + sending, sent, delivered, read, failed
  --
  canTransition(to)
}
class ChatCatalog <<AggregateRoot>> {
  chats: ChatSummaryProps[]
  --
  {static} empty()
  {static} of(chats)
  list()
  replaceAll(summaries)
  applyPreview(chatId, last)
  pullDomainEvents()
}
class ChatThread <<AggregateRoot>> {
  chatId: ChatId
  --
  {static} empty(chatId)
  {static} rehydrate(chatId, messages)
  hydrate(remote)
  accept(incoming)
  sendOptimistic(...)
  markFailed(clientMsgId)
  applyDelivery(id, status, ...)
  timeline()
  pullDomainEvents()
}
class "Message" as ClientMessage <<Entity>> {
  id: MessageId
  clientMsgId: ClientMsgId
  status: MessageDeliveryStatus
  --
  {static} create(props)
  promote(toServerId)
  transition(to)
  matchesIdentity(...)
}
class ThreadHydrated <<DomainEvent>>
class MessageAccepted <<DomainEvent>>
class LastMessageChanged <<DomainEvent>>
class DeliveryStatusChanged <<DomainEvent>>
class CatalogReplaced <<DomainEvent>>
class ChatPreviewChanged <<DomainEvent>>
interface ChatProjectionRepository <<Repository>> {
  listChats()
  upsertChats(rows)
  listMessages(chatId)
  replaceMessages(chatId, rows)
  upsertMessage(row)
}

note as N_CLIENT
  Local Chat Projection: UI reads client aggregates;
  authority = Spring + IM Contract.
  Catalog and Thread are separate aggregates;
  ChatProjectionService / ChatThreadService
  orchestrate (not Catalog⊃Thread).
  Repository stores projection rows; rebuilds aggregates.
  Domain Event (client): in-process drain only.
end note

ChatCatalog ..> ChatId
ChatCatalog ..> ChatTitle
ChatCatalog ..> AvatarURL
ChatThread "1" *-- "0..*" ClientMessage
ChatThread --> ChatId
ClientMessage --> MessageId
ClientMessage --> ClientMsgId
ClientMessage --> MessageDeliveryStatus
ClientMessage --> MessageBody
ChatThread ..> ThreadHydrated
ChatThread ..> MessageAccepted
ChatThread ..> LastMessageChanged
ChatThread ..> DeliveryStatusChanged
ChatCatalog ..> CatalogReplaced
ChatCatalog ..> ChatPreviewChanged
ChatProjectionRepository ..> ChatCatalog : rows ↔
ChatProjectionRepository ..> ClientMessage : rows ↔
N_CLIENT .. ChatThread
N_CLIENT .. ChatCatalog

