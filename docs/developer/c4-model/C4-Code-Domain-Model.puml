@startuml C4-Code-Domain-Model
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

title Code diagram (C4) - Chat domain model (as-built)

legend right
  |= Stereotype |= Meaning |
  | <<AggregateRoot>> | Consistency boundary |
  | <<Entity>> | Identity + lifecycle |
  | <<ValueObject>> | Immutable by value |
  | <<DomainService>> | Stateless domain / port |
  | <<DomainEvent>> | Fact from aggregate (client) |
  | <<Repository>> | Outbound port in domain/ |
endlegend

note as N_LAYERS
  controller → service → domain ← infra (+ mapper)
  Kernel: AbstractImmutable / AbstractEntity.
  Persist: JPA + Liquibase (H2 / Postgres).
  Java: src/main/java/com.chat.
  TS clients (web/mobile, duplicated): Local Chat Projection
  — ChatCatalog / ChatThread / Message + VOs.
  No shared npm IM package.
  Wire SSoT: src/main/im-contract/openapi.yaml
end note

abstract class AbstractImmutable <<Abstract>> {
  + id: String
  + createdAt: Instant
}
abstract class AbstractEntity <<Abstract>> {
  + updatedAt: Instant
  + version: long
  # touch()
}

AbstractImmutable <|-- AbstractEntity

class ChatUser <<AggregateRoot>> {
  String username
  String email
  String phone
  String avatar
  String status
  boolean online
  Instant lastSeen
  --
  {static} register(...)
  updateProfile(...)
  markOnline(online)
}
interface UserRepository <<Repository>> {
  findById(id)
  findByEmail(email)
  findByUsername(username)
  findByUsernameContainingIgnoreCase(q)
  save(user)
}

class UserFollow <<Entity>> {
  String id
  String followerId
  String followingId
  Date createdAt
}

ChatUser "1" o-- "0..*" UserFollow : follower
ChatUser "1" o-- "0..*" UserFollow : following

class Chat <<AggregateRoot>> {
  ChatType type
  String name
  String avatar
  boolean deleted
  --
  {static} createPrivate()
  {static} createGroup(name)
  rename(name)
  softDelete()
}
enum ChatType <<ValueObject>> {
  PRIVATE
  GROUP
}
class ChatParticipant <<Entity>> {
  String chatId
  String userId
  String role
  boolean archived
  boolean muted
  --
  {static} join(chatId, userId, role)
  archive(archived)
  mute(muted)
}
interface ChatRepository <<Repository>> {
  findById(id)
  save(chat)
}
interface ChatParticipantRepository <<Repository>> {
  findByChatId(chatId)
  existsByChatIdAndUserId(chatId, userId)
  save(participant)
}

Chat "1" *-- "1..*" ChatParticipant
Chat --> ChatType
ChatParticipant --> ChatUser

class Message <<AggregateRoot>> {
  String chatId
  String senderId
  String type
  String content
  String mediaUrl
  boolean deleted
  --
  {static} send(chatId, senderId, content)
  edit(content)
  softDelete()
}
class MessageReaction <<Entity>> {
  String messageId
  String userId
  String emoji
}
class MessageRead <<Entity>> {
  String messageId
  String userId
}
interface MessageRepository <<Repository>> {
  save(message)
  findById(id)
  findByChatId(chatId, ...)
}
note right of Message
  Participant checks live in ChatsService
  (not Chat.ensureParticipant).
  Soft delete: softDelete() → deleted.
  clientMsgId is client Local Chat Projection only.
end note

class SpringDataMessageRepository {
  save(message)
  findById(id)
  findByChatId(chatId, ...)
}
class SpringDataChatRepository {
  findById(id)
  save(chat)
}
class SpringDataChatParticipantRepository {
  findByChatId(chatId)
  existsByChatIdAndUserId(...)
  save(participant)
}

SpringDataMessageRepository ..|> MessageRepository
SpringDataChatRepository ..|> ChatRepository
SpringDataChatParticipantRepository ..|> ChatParticipantRepository

Chat "1" o-- "0..*" Message : chatId
Message "1" o-- "0..*" MessageReaction
Message "1" o-- "0..*" MessageRead
Message --> ChatUser : senderId
Message ..> MessageRepository
Chat ..> ChatRepository

