@startuml C4-Code-Domain-Model
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

title Code diagram (C4) - ExploreChat domain model (as-built)

legend right
  |= Stereotype |= Meaning |
  | <<AggregateRoot>> | Consistency boundary |
  | <<Entity>> | Identity + lifecycle |
  | <<ValueObject>> | Immutable by value |
  | <<DomainService>> | Stateless domain / port |
  | <<Repository>> | Outbound port in domain/ |
endlegend

note as N_LAYERS
  presentation → application → domain ← infrastructure
  Clients call Nest /api/v1 only.
  Persist: Prisma SQLite (users, chats, social_posts,
  feed_entries, post_comments, activity_notifications).
  Packages under services/server/src.
end note

package "users/domain" as pkg_users {
  class User <<AggregateRoot>> {
    String id
    String username
    String email
    String phone
    String avatar
    String status
    boolean isOnline
    Date lastSeen
    --
    {static} create(data)
    updateStatus(status)
    setOnline(isOnline)
  }
  interface IUserRepository <<Repository>> {
    findById(id)
    findByEmail(email)
    findByUsername(username)
    save(user)
  }
}

package "follow (UserFollow)" as pkg_follow {
  class UserFollow <<Entity>> {
    String id
    String followerId
    String followingId
    Date createdAt
  }
}

User "1" o-- "0..*" UserFollow : follower
User "1" o-- "0..*" UserFollow : following

package "chats/domain" as pkg_chats {
  class Chat <<AggregateRoot>> {
    String id
    ChatType type
    String name
    String avatar
    int unreadCount
    --
    {static} create(data)
    updateLastMessage(message)
    incrementUnreadCount()
    resetUnreadCount()
  }
  enum ChatType <<ValueObject>> {
    PRIVATE
    GROUP
  }
  class ChatParticipant <<Entity>> {
    String userId
    ParticipantRole role
    boolean isArchived
    boolean isMuted
  }
}

Chat "1" *-- "1..*" ChatParticipant
Chat --> ChatType
Chat "1" o-- "0..1" Message : lastMessage
ChatParticipant --> User

package "messages/domain" as pkg_messages {
  class Message <<AggregateRoot>> {
    String id
    String chatId
    String senderId
    MessageType type
    String content
    String mediaUrl
    boolean isEdited
    boolean isDeleted
    --
    {static} create(data)
    edit(content)
    delete()
    addReaction(userId, emoji)
    markAsRead(userId)
  }
  enum MessageType <<ValueObject>> {
    TEXT
    IMAGE
    VIDEO
    AUDIO
    FILE
  }
  class MessageReaction <<ValueObject>> {
    String userId
    String emoji
  }
  interface IMessageRepository <<Repository>> {
    save(message)
    findByChatId(chatId)
  }
}

Chat "1" *-- "0..*" Message
Message --> MessageType
Message "1" *-- "0..*" MessageReaction
Message --> User : senderId

package "groups/domain" as pkg_groups {
  class Group <<AggregateRoot>> {
    String id
    String name
    String creatorId
    --
    {static} create(data)
    addParticipant(userId, addedBy, role)
    removeParticipant(userId)
  }
  class GroupParticipant <<ValueObject>> {
    String userId
    ParticipantRole role
  }
  enum ParticipantRole <<ValueObject>> {
    ADMIN
    MEMBER
  }
}

Group "1" *-- "0..*" GroupParticipant
GroupParticipant --> ParticipantRole
ChatParticipant --> ParticipantRole

package "post/domain" as pkg_post {
  class Post <<AggregateRoot>> {
    String postId
    String userId
    String caption
    String type
    String[] mediaUrls
    String coverUrl
    String location
    Date createdAt
    --
    {static} create(input)
  }
  class FeedEntry <<ValueObject>> {
    String postId
    String authorId
    Date createdAt
  }
  class EngagementCounts <<ValueObject>> {
    int likeCount
    int commentCount
    int saveCount
  }
  interface IPostRepository <<Repository>> {
    insertPost(input)
    getPostById(postId)
    getPostsByUserId(userId, limit)
    deletePost(postId, userId)
  }
  interface IEngagementRepository <<Repository>> {
    like(userId, postId)
    unlike(userId, postId)
    save(userId, postId)
    unsave(userId, postId)
    getEngagementCounts(postId)
  }
}

Post --> User : author
Post --> FeedEntry
Post --> EngagementCounts
Post "1" o-- "0..*" Comment

package "comments/domain" as pkg_comments {
  class Comment <<Entity>> {
    String id
    String postId
    String userId
    String content
    String parentId
  }
  interface ICommentRepository <<Repository>> {
    insert(doc)
    findByPostId(postId, limit, skip)
    findById(id)
    deleteOne(id, userId)
  }
}

Comment --> User : author

package "notifications/domain" as pkg_notifications {
  class NotificationItem <<Entity>> {
    String id
    String recipientId
    String actorId
    NotificationType type
    String postId
    String commentId
    Date createdAt
    Date readAt
  }
  enum NotificationType <<ValueObject>> {
    like
    comment
  }
  interface INotificationRepository <<Repository>> {
    upsertLike(...)
    insertComment(...)
    findByRecipient(...)
    markRead(...)
  }
}

NotificationItem --> NotificationType
NotificationItem --> Post

package "auth/domain" as pkg_auth {
  interface IAuthService <<DomainService>> {
    register(data)
    login(data)
    refresh(token)
  }
  class AuthTokens <<ValueObject>> {
    String accessToken
    String refreshToken
  }
}

IAuthService ..> User
IAuthService ..> AuthTokens

N_LAYERS .. pkg_users
N_LAYERS .. pkg_chats
N_LAYERS .. pkg_post

@enduml
