    Date createdAt
  }
}

User "1" o-- "0..*" UserFollow : follower
User "1" o-- "0..*" UserFollow : following

' ── Chat ───────────────────────────────────────────────────
package "Chat" as pkg_chat {
  class Chat <<AggregateRoot>> {
    ChatType type
    String name
    String avatar
    boolean deleted
    --
    {static} createPrivate()
    {static} createGroup(name)
    rename(name)
    markDeleted()
  }
  enum ChatType <<ValueObject>> {
    PRIVATE
    GROUP
  }
  class ChatParticipant <<Entity>> {
    String chatId
    String userId
    String role
    boolean archived
    boolean muted
    --
    {static} createParticipant(chatId, userId, role)
    archive(archived)
    mute(muted)
  }
  interface ChatRepository <<Repository>> {
    findById(id)
    save(chat)
  }
  interface ChatParticipantRepository <<Repository>> {
    findByChatId(chatId)
    existsByChatIdAndUserId(chatId, userId)
    save(participant)
  }
  class SpringDataChatRepository {
    findById(id)
    save(chat)
  }
  class SpringDataChatParticipantRepository {
    findByChatId(chatId)
    existsByChatIdAndUserId(...)
    save(participant)
  }
}

Chat "1" *-- "1..*" ChatParticipant
Chat --> ChatType
ChatParticipant --> User

' ── Message ────────────────────────────────────────────────
package "Message" as pkg_message {
  class Message <<AggregateRoot>> {
    String chatId
    String senderId
    MessageType type
    String content
    String mediaUrl
    boolean deleted
    --
    {static} createMessage(chatId, senderId, content)
    edit(content)
    markDeleted()
  }
  enum MessageType <<Enum>> {
    TEXT
  }
  class MessageReaction <<Entity>> {
    String messageId
    String userId
    String emoji
  }
  class MessageRead <<Entity>> {
    String messageId
    String userId
  }
  interface MessageRepository <<Repository>> {
    save(message)
    findById(id)
    findByChatId(chatId, ...)
  }
  note right of Message
    Participant checks live in ChatsService
    (not Chat.ensureParticipant).
    Soft delete: markDeleted() → deleted.
    clientMsgId is client Local Chat Projection only.
  end note
  class SpringDataMessageRepository {
    save(message)
    findById(id)
    findByChatId(chatId, ...)
  }
}

SpringDataMessageRepository ..|> MessageRepository
SpringDataChatRepository ..|> ChatRepository
SpringDataChatParticipantRepository ..|> ChatParticipantRepository

