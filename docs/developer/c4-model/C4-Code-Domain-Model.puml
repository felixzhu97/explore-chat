' ── notifications ──────────────────────────────────────────
package "notifications/domain" as pkg_notifications {
  class NotificationItem <<Entity>> {
    String id
    String recipientId
    String actorId
    NotificationType type
    String postId
    String commentId
    String contentPreview
    Date createdAt
    Date readAt
  }
  enum NotificationType <<ValueObject>> {
    like
    comment
  }
  interface INotificationRepository <<Repository>> {
    upsertLike(recipientId, actorId, postId)
    insertComment(...)
    findByRecipient(recipientId, limit)
    markRead(recipientId, id)
    markAllRead(recipientId)
  }
}

NotificationItem --> NotificationType
NotificationItem --> User : recipient / actor
NotificationItem --> Post

' ── media ──────────────────────────────────────────────────
package "media" as pkg_media {
  class FileUpload <<Entity>> {
    String id
    String originalName
    String filename
    String mimetype
    int size
    String url
    String thumbnailUrl
    String uploadedBy
  }
}

FileUpload --> User : uploadedBy
Post ..> FileUpload : mediaUrls
Message ..> FileUpload : mediaUrl

' ── auth (application port) ────────────────────────────────
package "auth/domain" as pkg_auth {
  interface IAuthService <<DomainService>> {
    register(data)
    login(data)
    refresh(token)
  }
  class AuthTokens <<ValueObject>> {
    String accessToken
    String refreshToken
  }
}

IAuthService ..> User
IAuthService ..> AuthTokens

N_LAYERS .. pkg_users
N_LAYERS .. pkg_chats
N_LAYERS .. pkg_post
N_LAYERS .. pkg_messages

@enduml
