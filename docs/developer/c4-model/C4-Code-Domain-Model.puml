title Code diagram (C4) — Domain model (by business domain)

legend right
  |= Stereotype |= Meaning |
  | <<AggregateRoot>> | Consistency boundary |
  | <<Entity>> | Identity + lifecycle |
  | <<ValueObject>> | Immutable by value |
  | <<DomainService>> | Stateless domain / port |
  | <<DomainEvent>> | Fact from aggregate (client) |
  | <<Repository>> | Outbound port in domain/ |
endlegend

note as N_LAYERS
  controller → service → domain ← infra (+ mapper)
  domain = model (entities, aggregates, value objects)
  + repository ports only. No domain.vo package.
  Kernel: AbstractImmutable / AbstractEntity
  (@CreationTimestamp / @UpdateTimestamp).
  Bean Validation on aggregate fields; typed enums.
  Persist: JPA + Liquibase 0.1 only
  (db/changelog/0.1.xml createTable baseline).
  Preferred Terms: docs/Glossary.md
  Java: src/main/java/com.chat.
  TS clients (web/mobile, duplicated): Local Chat Projection
  — ChatCatalog / ChatThread / Message + VOs.
  No shared npm IM package.
  Wire SSoT: src/main/im-contract/openapi.yaml
end note

' ── Domain Kernel ──────────────────────────────────────────
package "Domain Kernel" as pkg_kernel {
  abstract class AbstractImmutable <<Abstract>> {
    + id: String
    + createdAt: Instant @CreationTimestamp
  }
  abstract class AbstractEntity <<Abstract>> {
    + updatedAt: Instant @UpdateTimestamp
    + version: long
    # touch()
  }
}

AbstractImmutable <|-- AbstractEntity

' ── Auth ───────────────────────────────────────────────────
package "Auth" as pkg_auth {
  interface AuthService <<DomainService>> {
    createUser(data)
    login(data)
    refresh(token)
  }
  class AuthTokens <<ValueObject>> {
    String accessToken
    String refreshToken
  }
}

AuthService ..> AuthTokens

' ── User ───────────────────────────────────────────────────
package "User" as pkg_user {
  class User <<AggregateRoot>> {
    String username
    String email
    String phone
    String avatar
    String status
    boolean online
    Instant lastSeen
    --
    {static} createUser(...)
    updateProfile(...)
    markOnline(online)
  }
  interface UserRepository <<Repository>> {
    findById(id)
    findByEmail(email)
    findByUsername(username)
    findByUsernameContainingIgnoreCase(q)
    save(user)
  }
}

AuthService ..> User

' ── Follow ─────────────────────────────────────────────────
package "Follow" as pkg_follow {
  class UserFollow <<Entity>> {
