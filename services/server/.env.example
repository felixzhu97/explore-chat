# Local development defaults (aligned with services/server/docker-compose.yml).
# Copy to .env if missing: `pnpm dev` does this automatically.
# Leave CASSANDRA_CONTACT_POINTS / ELASTICSEARCH_NODE / MONGODB_URI / KAFKA_BROKERS
# empty only when you intentionally disable that subsystem.

NODE_ENV=development
PORT=3001

# Postgres 18 (compose service postgres → host 5433)
DATABASE_URL="postgresql://whatschat:whatschat123@localhost:5433/whatschat?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (dev only — use long random secrets in production)
JWT_SECRET="whatschat-dev-jwt-secret-key-32chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="whatschat-dev-refresh-secret-32c"
JWT_REFRESH_EXPIRES_IN="30d"

# Redpanda (Kafka API) — localhost:9092
KAFKA_BROKERS="localhost:9092"
# KAFKA_TOPIC_POST_CREATED="post.created"
# KAFKA_TOPIC_FEED_FANOUT="feed.fanout"
# KAFKA_TOPIC_COMMENT_CREATED="comment.created"

# ScyllaDB (CQL) — same driver settings as Cassandra
CASSANDRA_CONTACT_POINTS="localhost:9042"
CASSANDRA_KEYSPACE="whatschat"
CASSANDRA_LOCAL_DC="datacenter1"

# MongoDB
MONGODB_URI="mongodb://localhost:27017/whatschat"

# Elasticsearch
ELASTICSEARCH_NODE="http://localhost:9200"
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=

# Local uploads / MinIO-compatible defaults
UPLOAD_DIR="./uploads"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="whatschat-media"
MINIO_REGION="us-east-1"
MINIO_PUBLIC_BASE_URL="http://localhost:3001/uploads/media"

MAX_FILE_SIZE="10485760"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp,image/heic,image/heif,video/mp4,video/webm,video/quicktime,audio/mpeg"

RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# WebRTC (dev placeholders)
TURN_SERVER_URL="turn:localhost:3478"
TURN_SERVER_USERNAME="test"
TURN_SERVER_CREDENTIAL="test"

# AI / side services (soft-started by pnpm dev when available)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen3-coder:30b"
MEDIA_GENERATION_API_URL="http://localhost:3456"
RECOMMENDATION_API_URL="http://localhost:8000"
# VISION_ENABLED=true
# VISION_SERVICE_URL="http://localhost:8001"
# RAG_SERVICE_URL="http://localhost:8002"

# Explore AI BFF (optional)
# EXPLORE_AI_ENABLED=true
# EXPLORE_AI_BASE_URL="http://localhost:9000"
# EXPLORE_AI_SERVICE_KEY="your-shared-service-key"
# EXPLORE_AI_TIMEOUT_MS=60000
