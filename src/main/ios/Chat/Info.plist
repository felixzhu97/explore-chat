	<string>Chat needs the microphone for calls.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Chat needs photos for posts and avatars.</string>
	<key>UIAppFonts</key>
	<array>
		<string>GrandHotel-Regular.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
